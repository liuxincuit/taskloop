{
  "intervalSeconds": 60,
  "agent": "pi",
  "pi": {
    "sessionDir": "./.pi-sessions"
  },
  "rules": [
    {
      "source": "youtrack",
      "labels": ["ready"],
      "notLabels": ["explored"],
      "assignee": "me",
      "promptTemplate": "templates/yt-explorer.md"
    },
    {
      "source": "wiki",
      "labels": ["ready"],
      "notLabels": ["explored"],
      "assignee": "me",
      "promptTemplate": "templates/wiki-exploer.md"
    },
    {
      "source": "jira",
      "labels": ["taskloop"],
      "notLabels": ["explored"],
      "assignee": "me",
      "promptTemplate": "templates/analyze.md"
    }
  ]
}
