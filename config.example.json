{
  "intervalSeconds": 60,
  "model": "opencode-go/deepseek-v4.1-flash",
  "thinking": "max",
  "workdir": "~/.taskloop/workdir",
  "sessionDir": "~/.taskloop/sessions",
  "envFile": "~/.pi/agent/.env",
  "rules": [
    {
      "source": "youtrack",
      "labels": ["ready"],
      "notLabels": ["done"],
      "assignee": "me",
      "promptTemplate": "templates/analyze.md"
    },
    {
      "source": "wiki",
      "labels": ["ready"],
      "notLabels": ["done"],
      "assignee": "me",
      "promptTemplate": "templates/analyze.md"
    },
    {
      "source": "jira",
      "labels": ["taskloop"],
      "notLabels": ["explored"],
      "assignee": "me",
      "promptTemplate": "templates/example-workflow.md"
    },
    {
      "source": "scrum",
      "labels": ["taskloop"],
      "notLabels": ["explored"],
      "promptTemplate": "templates/scrum-test.md"
    }
  ]
}
